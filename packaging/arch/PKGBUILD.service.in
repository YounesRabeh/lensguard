# Maintainer: Younes Rabeh <younesrabeh@users.noreply.github.com>
pkgname=lensguard-service
pkgver=@VERSION@
pkgrel=1
pkgdesc='Camera monitor service for the Lens Guard GNOME extension'
arch=('@ARCHITECTURE@')
url='https://github.com/YounesRabeh/lensguard'
license=('GPL-3.0-or-later')
depends=('dbus' 'pipewire' 'systemd')
conflicts=('lensguard')
source=('lensguard-service-root.tar.gz')
sha256sums=('@SHA256@')
options=('strip' '!debug')

package() {
    install -d "$pkgdir"
    cp -a "$srcdir/root/." "$pkgdir/"
}
