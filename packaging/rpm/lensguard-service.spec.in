Name:           lensguard-service
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Camera monitor service for the Lens Guard GNOME extension
License:        GPL-3.0-or-later
URL:            https://github.com/younesrabeh/lensguard
Source0:        lensguard-%{version}.tar.gz

BuildRequires:  cargo
BuildRequires:  clang
BuildRequires:  rust
BuildRequires:  systemd-rpm-macros
Requires:       dbus
Requires:       systemd
Conflicts:      lensguard

%description
Installs the Lens Guard user daemon, privileged metadata-only V4L2 observer,
trusted-broker policy, system and user service units, and D-Bus activation
service. Install the GNOME extension separately from extensions.gnome.org.

%prep
%autosetup -n lensguard-%{version}

%build
export CARGO_NET_OFFLINE=true
cargo build --locked --offline --release -p camera-monitor -p lensguard-v4l2-observer

%install
install -d -m 0755 \
    %{buildroot}%{_libexecdir}/lensguard \
    %{buildroot}%{_unitdir} \
    %{buildroot}%{_userunitdir} \
    %{buildroot}%{_datadir}/dbus-1/services \
    %{buildroot}%{_datadir}/lensguard \
    %{buildroot}%{_datadir}/doc/lensguard-service \
    %{buildroot}%{_datadir}/licenses/lensguard-service
install -m 0755 target/release/camera-monitor \
    %{buildroot}%{_libexecdir}/lensguard/camera-monitor
install -m 0755 target/release/lensguard-v4l2-observer \
    %{buildroot}%{_libexecdir}/lensguard/lensguard-v4l2-observer
sed 's|@EXECUTABLE@|%{_libexecdir}/lensguard/camera-monitor|g' \
    systemd/camera-monitor.service.in > %{buildroot}%{_userunitdir}/camera-monitor.service
sed 's|@EXECUTABLE@|%{_libexecdir}/lensguard/camera-monitor|g' \
    systemd/io.github.younesrabeh.CameraMonitor.service.in \
    > %{buildroot}%{_datadir}/dbus-1/services/io.github.younesrabeh.CameraMonitor.service
sed 's|@EXECUTABLE@|%{_libexecdir}/lensguard/lensguard-v4l2-observer|g' \
    systemd/lensguard-v4l2-observer.service.in \
    > %{buildroot}%{_unitdir}/lensguard-v4l2-observer.service
install -m 0644 observer/policy/trusted-brokers-v1.json \
    %{buildroot}%{_datadir}/lensguard/trusted-brokers-v1.json
install -m 0644 README.md %{buildroot}%{_datadir}/doc/lensguard-service/README.md
install -m 0644 docs/installation.md \
    %{buildroot}%{_datadir}/doc/lensguard-service/installation.md
install -m 0644 dbus/io.github.younesrabeh.CameraMonitor1.xml \
    %{buildroot}%{_datadir}/doc/lensguard-service/io.github.younesrabeh.CameraMonitor1.xml
install -m 0644 LICENSE %{buildroot}%{_datadir}/licenses/lensguard-service/LICENSE

%post
%systemd_user_post camera-monitor.service
%systemd_post lensguard-v4l2-observer.service

%preun
%systemd_user_preun camera-monitor.service
%systemd_preun lensguard-v4l2-observer.service

%postun
%systemd_user_postun_with_restart camera-monitor.service
%systemd_postun_with_restart lensguard-v4l2-observer.service

%files
%license %{_datadir}/licenses/lensguard-service/LICENSE
%doc %{_datadir}/doc/lensguard-service/README.md
%doc %{_datadir}/doc/lensguard-service/installation.md
%doc %{_datadir}/doc/lensguard-service/io.github.younesrabeh.CameraMonitor1.xml
%dir %{_libexecdir}/lensguard
%{_libexecdir}/lensguard/camera-monitor
%{_libexecdir}/lensguard/lensguard-v4l2-observer
%{_unitdir}/lensguard-v4l2-observer.service
%{_userunitdir}/camera-monitor.service
%{_datadir}/dbus-1/services/io.github.younesrabeh.CameraMonitor.service
%{_datadir}/lensguard/trusted-brokers-v1.json

%changelog
* Sun Aug 09 2026 Younes Rabeh <younesrabeh@users.noreply.github.com> - @VERSION@-1
- Add service-only package for GNOME Store installations
