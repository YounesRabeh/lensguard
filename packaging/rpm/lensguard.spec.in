Name:           lensguard
Version:        @VERSION@
Release:        1%{?dist}
Summary:        GNOME Shell camera privacy indicator
License:        MIT
URL:            https://github.com/younesrabeh/lensguard
Source0:        lensguard-%{version}.tar.gz

BuildRequires:  cargo
BuildRequires:  clang
BuildRequires:  glib2
BuildRequires:  gnome-shell
BuildRequires:  pkgconfig
BuildRequires:  pipewire-devel
BuildRequires:  ripgrep
BuildRequires:  rust
BuildRequires:  systemd-rpm-macros
BuildRequires:  unzip
Requires:       dbus
Requires:       gnome-shell >= 50
Requires:       pipewire
Requires:       systemd

%description
LensGuard monitors active camera capture through PipeWire and shows the
applications using the camera through a GNOME Shell extension.

%prep
%autosetup -n lensguard-%{version}

%build
export CARGO_NET_OFFLINE=true
cargo build --locked --offline --release -p camera-monitor
./scripts/package-extension.sh build/extension

%install
install -d -m 0755 \
    %{buildroot}%{_libexecdir}/lensguard \
    %{buildroot}%{_userunitdir} \
    %{buildroot}%{_datadir}/dbus-1/services \
    %{buildroot}%{_datadir}/gnome-shell/extensions/lensguard@younesrabeh.github.io \
    %{buildroot}%{_datadir}/doc/lensguard \
    %{buildroot}%{_datadir}/licenses/lensguard
install -m 0755 target/release/camera-monitor \
    %{buildroot}%{_libexecdir}/lensguard/camera-monitor
sed 's|@EXECUTABLE@|%{_libexecdir}/lensguard/camera-monitor|g' \
    systemd/camera-monitor.service.in > %{buildroot}%{_userunitdir}/camera-monitor.service
sed 's|@EXECUTABLE@|%{_libexecdir}/lensguard/camera-monitor|g' \
    systemd/io.github.younesrabeh.CameraMonitor.service.in \
    > %{buildroot}%{_datadir}/dbus-1/services/io.github.younesrabeh.CameraMonitor.service
unzip -q build/extension/lensguard@younesrabeh.github.io.shell-extension.zip \
    -d %{buildroot}%{_datadir}/gnome-shell/extensions/lensguard@younesrabeh.github.io
glib-compile-schemas --strict \
    %{buildroot}%{_datadir}/gnome-shell/extensions/lensguard@younesrabeh.github.io/schemas
install -m 0644 README.md %{buildroot}%{_datadir}/doc/lensguard/README.md
install -m 0644 docs/installation.md %{buildroot}%{_datadir}/doc/lensguard/installation.md
install -m 0644 dbus/io.github.younesrabeh.CameraMonitor1.xml \
    %{buildroot}%{_datadir}/doc/lensguard/io.github.younesrabeh.CameraMonitor1.xml
install -m 0644 LICENSE %{buildroot}%{_datadir}/licenses/lensguard/LICENSE

%post
%systemd_user_post camera-monitor.service

%preun
%systemd_user_preun camera-monitor.service

%postun
%systemd_user_postun_with_restart camera-monitor.service

%files
%license %{_datadir}/licenses/lensguard/LICENSE
%doc %{_datadir}/doc/lensguard/README.md
%doc %{_datadir}/doc/lensguard/installation.md
%doc %{_datadir}/doc/lensguard/io.github.younesrabeh.CameraMonitor1.xml
%dir %{_libexecdir}/lensguard
%{_libexecdir}/lensguard/camera-monitor
%{_userunitdir}/camera-monitor.service
%{_datadir}/dbus-1/services/io.github.younesrabeh.CameraMonitor.service
%{_datadir}/gnome-shell/extensions/lensguard@younesrabeh.github.io

%changelog
* Fri Aug 07 2026 Younes Rabeh <younesrabeh@users.noreply.github.com> - @VERSION@-1
- Initial package
